# Supabase — client-side. Both values are public by design.
# Same project as the public site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the public site runs. Verification links point here, because the
# member confirming them belongs on the member site, not in this portal.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The single password that opens the portal. Defaults to "password" when
# unset, which is fine for local development and is exactly why this must not
# be deployed anywhere reachable as it stands.
ADMIN_PORTAL_PASSWORD=password

# Supabase secret key. Bypasses Row Level Security, so it is server-only and
# must never be given a NEXT_PUBLIC_ prefix. Required: with a shared password
# there is no per-administrator session, so account lookups use this key too.
SUPABASE_SECRET_KEY=
