# Supabase — client-side. Both values are public by design.
# Same project as the public site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the public site runs. Verification links point here, because the
# member confirming them belongs on the member site, not in this portal.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase secret key. Bypasses Row Level Security, so it is server-only and
# must never be given a NEXT_PUBLIC_ prefix. Needed by one action — resetting
# a member's verification — and read lazily, so the portal runs without it
# until that action is used.
SUPABASE_SECRET_KEY=
