# The root .gitignore anchors its patterns to the repository root
# (/node_modules, /.next/), so they do not reach this app. Ignoring here keeps
# the rules next to the thing they describe.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# Written by `next dev` when run under an AI agent.
AGENTS.md
CLAUDE.md
